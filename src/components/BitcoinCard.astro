---
import PsybitcoinButton from './PsybitcoinButton.vue'
import CopyButton from './CopyButton.astro'

const BC1_ADDRESS = 'bc1qzsdges0lm34jkjfydgltr6jqnuxcjrj7rapuyy'
const LN_ADDRESS = 'psycarlo@walletofsatoshi.com'
---

<div class="reveal flex flex-col gap-4">
  <slot />
  <div class="flex flex-col gap-2">
    <h3 class="text-2xl font-medium tracking-tight">Learn about Bitcoin</h3>
    <p class="text-brand-grayDark dark:text-brand-gray">
      Psybitcoin is a learning platform that teaches about bitcoin and other
      exciting topics. Video lessons are currently only available in Portuguese.
    </p>
    <p class="text-brand-grayDark dark:text-brand-gray">
      In psybitcoin you can watch engaging videos that will teach you everything
      in a simplified way, track the price of bitcoin with a wonderful custom
      chart, interact with the community, read articles, invite friends and earn
      achievements and bitcoin.
    </p>
  </div>
</div>
<div class="reveal mt-4 flex justify-center">
  <PsybitcoinButton />
</div>
<div class="reveal mt-8">
  <div class="flex flex-col gap-2">
    <h3 class="text-2xl font-medium tracking-tight">Buy me a coffee</h3>
    <p class="text-brand-grayDark dark:text-brand-gray">
      Want to buy me a coffee? I am taking bitcoin ;)
    </p>
    <div class="flex gap-4">
      <div>
        <div class="flex flex-col items-center">
          <p class="mb-2 font-medium">On-chain</p>
          <slot name="qr" />
          <p
            class="text-brand-grayDark dark:text-brand-gray mt-1 text-center text-xs"
          >
            scan the qr code
          </p>
        </div>
        <div class="mt-3 flex items-center justify-center gap-4">
          <CopyButton text="Copy Address" copyText={BC1_ADDRESS} />
        </div>
      </div>
      <div>
        <div class="flex flex-col items-center">
          <p class="mb-2 font-medium">Lightning Address</p>
          <slot name="qrln" />
          <p
            class="text-brand-grayDark dark:text-brand-gray mt-1 text-center text-xs"
          >
            scan the qr code
          </p>
        </div>
        <div class="mt-3 flex items-center justify-center gap-4">
          <CopyButton text="Copy Address" copyText={LN_ADDRESS} />
        </div>
      </div>
    </div>
  </div>
</div>
