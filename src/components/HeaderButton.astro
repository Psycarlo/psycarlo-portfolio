---
interface Props {
  title: string
  href: string
  selected: boolean
  ariaLabel: string
}

const { title, href, selected, ariaLabel } = Astro.props
---

<a
  href={href}
  class:list={[
    'group hover:bg-brand-light dark:hover:bg-brand-dark xs:h-10 xs:w-10 relative flex h-9 w-9 items-center justify-center rounded-full transition-[background-color,scale] duration-150 ease-out active:scale-[0.96]',
    selected && 'bg-brand-light dark:bg-brand-dark'
  ]}
  aria-label={ariaLabel}
  aria-current={selected ? 'page' : undefined}
>
  <span
    class:list={[
      selected
        ? 'text-brand-darkest dark:text-brand-lightest'
        : 'text-brand-grayDark dark:text-brand-gray'
    ]}
  >
    <slot />
  </span>
  {
    selected && (
      <span
        aria-hidden="true"
        class="absolute -bottom-1.5 left-1/2 h-1 w-1 -translate-x-1/2 rounded-full bg-orange-500"
        transition:name="nav-indicator"
        transition:animate="initial"
      />
    )
  }
  <span
    aria-hidden="true"
    class="nav-tooltip bg-brand-darkest text-brand-lightest dark:bg-brand-dark dark:text-brand-lightest pointer-events-none absolute top-full left-1/2 z-100 mt-4 -translate-x-1/2 origin-top rounded-lg px-2.5 py-1.5 text-xs font-medium whitespace-nowrap opacity-0 shadow-[0_8px_24px_-8px_oklch(0_0_0/0.35),inset_0_1px_0_oklch(1_0_0/0.08)] transition-[opacity,scale] duration-150 ease-out select-none group-hover:opacity-100 group-hover:delay-300 group-focus-visible:opacity-100 motion-safe:scale-[0.97] motion-safe:group-hover:scale-100 motion-safe:group-focus-visible:scale-100"
  >
    {title}
  </span>
</a>
