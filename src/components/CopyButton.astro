---
interface Props {
  text: string
  copyText: string
  class?: string
}

const { text, copyText, class: className } = Astro.props
---

<button
  type="button"
  class:list={[
    'group bg-brand-lightest shadow-border hover:shadow-border-hover flex h-10 shrink-0 cursor-pointer items-center gap-1.5 rounded-full border border-transparent ps-3.5 pe-4 text-sm font-medium transition-[background-color,box-shadow,scale] duration-150 ease-out active:scale-[0.96] dark:bg-transparent dark:hover:bg-white/4',
    className
  ]}
  data-copy={copyText}
>
  <span class="grid h-5 w-5 place-items-center" aria-hidden="true">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      stroke-width="1.5"
      stroke="currentColor"
      class="ease-icon h-5 w-5 blur-[0px] transition-[opacity,filter,scale] duration-300 [grid-area:1/1] group-data-copied:opacity-0 motion-safe:group-data-copied:scale-[0.25] motion-safe:group-data-copied:blur-[4px]"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M15.666 3.888A2.25 2.25 0 0013.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 01-.75.75H9a.75.75 0 01-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 011.927-.184"
      ></path>
    </svg>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      stroke-width="2"
      stroke="currentColor"
      class="text-brand-success ease-icon h-5 w-5 opacity-0 blur-[0px] transition-[opacity,filter,scale] duration-300 [grid-area:1/1] group-data-copied:opacity-100 motion-safe:scale-[0.25] motion-safe:blur-[4px] motion-safe:group-data-copied:scale-100 motion-safe:group-data-copied:blur-[0px]"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M4.5 12.75l6 6 9-13.5"></path>
    </svg>
  </span>
  <span class="min-w-[10ch]" aria-live="polite" data-copy-label={text}>
    {text}
  </span>
</button>

<script>
  // Delegated so every copy button works without hydrating a framework, and
  // keeps working after client-side navigation swaps the page.
  const timers = new WeakMap<HTMLElement, number>()

  document.addEventListener('click', async (event) => {
    const target = event.target as Element | null
    const button = target?.closest<HTMLElement>('[data-copy]')
    const label = button?.querySelector<HTMLElement>('[data-copy-label]')
    if (!button || !label) return

    try {
      await navigator.clipboard.writeText(button.dataset.copy ?? '')
    } catch {
      return
    }

    label.textContent = 'Copied!'
    button.setAttribute('data-copied', '')
    clearTimeout(timers.get(button))
    timers.set(
      button,
      window.setTimeout(() => {
        label.textContent = label.dataset.copyLabel ?? ''
        button.removeAttribute('data-copied')
      }, 2000)
    )
  })
</script>
