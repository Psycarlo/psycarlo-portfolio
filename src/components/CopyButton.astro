---
interface Props {
  text: string
  copyText: string
  class?: string
}

const { text, copyText, class: className } = Astro.props
---

<button
  type="button"
  class:list={[
    'border-brand-grayLightest hover:ring-brand-light dark:border-brand-darky dark:hover:ring-brand-dark/40 flex cursor-pointer items-center gap-1 rounded-lg border px-3 py-2 text-sm font-medium shadow-sm ring-offset-1 ring-offset-transparent transition-all duration-300 hover:ring-[3px]',
    className
  ]}
  data-copy={copyText}
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    fill="none"
    viewBox="0 0 24 24"
    stroke-width="1.5"
    stroke="currentColor"
    class="h-5 w-5"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M15.666 3.888A2.25 2.25 0 0013.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 01-.75.75H9a.75.75 0 01-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 011.927-.184"
    ></path>
  </svg>
  <span class="min-w-[10ch]" aria-live="polite" data-copy-label={text}>
    {text}
  </span>
</button>

<script>
  // Delegated so every copy button works without hydrating a framework, and
  // keeps working after client-side navigation swaps the page.
  const timers = new WeakMap<HTMLElement, number>()

  document.addEventListener('click', async (event) => {
    const target = event.target as Element | null
    const button = target?.closest<HTMLElement>('[data-copy]')
    const label = button?.querySelector<HTMLElement>('[data-copy-label]')
    if (!button || !label) return

    try {
      await navigator.clipboard.writeText(button.dataset.copy ?? '')
    } catch {
      return
    }

    label.textContent = 'Copied!'
    clearTimeout(timers.get(button))
    timers.set(
      button,
      window.setTimeout(() => {
        label.textContent = label.dataset.copyLabel ?? ''
      }, 2000)
    )
  })
</script>
