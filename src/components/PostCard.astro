---
import { Image } from 'astro:assets'

const { id, title, pubDate, image } = Astro.props
---

<a
  href={`/blog/${id}/`}
  class="cursor-pointer dark:border-brand-grayDarkest group flex flex-col gap-2 rounded-lg border border-brand-light bg-brand-lightest p-4 shadow-sm transition-[translate,box-shadow,border-color] duration-300 ease-out hover:-translate-y-0.5 hover:border-brand-grayLightest hover:shadow-md dark:bg-brand-dark dark:hover:border-brand-grayDark motion-reduce:transition-none motion-reduce:hover:translate-y-0"
>
  <span class="font-mono dark:text-gray-300">
    {
      new Intl.DateTimeFormat('en-US', {
        month: 'long',
        day: 'numeric',
        year: 'numeric'
      }).format(pubDate)
    }
  </span>
  <Image
    src={image}
    alt=""
    class="rounded-md"
    transition:name={`hero-${id}`}
  />
  <h3 class="font-semibold text-xl py-2">{title}</h3>
</a>
