---
import { Image } from 'astro:assets'

const { id, title, pubDate, image } = Astro.props
---

<a
  href={`/blog/${id}/`}
  class="group bg-brand-lightest shadow-border hover:shadow-border-hover dark:bg-brand-dark flex cursor-pointer flex-col gap-1 rounded-3xl border border-transparent p-2 transition-[box-shadow,translate,scale] duration-200 ease-out active:scale-[0.99] motion-safe:hover:-translate-y-0.5"
>
  <Image
    src={image}
    alt=""
    class="img-outline rounded-2xl"
    transition:name={`hero-${id}`}
  />
  <div class="flex flex-col gap-1 px-3 pt-2 pb-3">
    <span
      class="text-brand-grayDark dark:text-brand-gray font-mono text-xs tracking-wide uppercase"
    >
      {
        new Intl.DateTimeFormat('en-US', {
          month: 'long',
          day: 'numeric',
          year: 'numeric'
        }).format(pubDate)
      }
    </span>
    <h3 class="text-xl font-semibold tracking-tight">{title}</h3>
  </div>
</a>
