<button
  type="button"
  title="Theme Toggle"
  aria-label="Toggle theme"
  class="group hover:bg-brand-light dark:hover:bg-brand-dark xs:h-10 xs:w-10 grid h-9 w-9 cursor-pointer place-items-center rounded-full transition-[background-color,scale] duration-150 ease-out active:scale-[0.96]"
  data-theme-toggle
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    fill="none"
    viewBox="0 0 24 24"
    stroke-width="1.5"
    stroke="currentColor"
    class="stroke-brand-darkest group-hover:fill-brand-darkest ease-icon h-6 w-6 blur-[0px] transition-[opacity,filter,scale,fill] duration-300 [grid-area:1/1] dark:opacity-0 motion-safe:dark:scale-[0.25] motion-safe:dark:blur-[4px]"
    data-theme-icon
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z"
    ></path>
  </svg>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    fill="none"
    viewBox="0 0 24 24"
    stroke-width="1.5"
    stroke="currentColor"
    class="stroke-brand-lightest group-hover:fill-brand-lightest ease-icon h-6 w-6 opacity-0 blur-[0px] transition-[opacity,filter,scale,fill] duration-300 [grid-area:1/1] dark:opacity-100 motion-safe:scale-[0.25] motion-safe:blur-[4px] motion-safe:dark:scale-100 motion-safe:dark:blur-[0px]"
    data-theme-icon
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z"
    ></path>
  </svg>
</button>

<script>
  // The icon is picked by CSS from the `dark` class on <html>, so the button
  // is correct before any JS runs. Delegated so it survives page swaps.
  function toggleTheme() {
    // Without this every color transition on the page fires at once and the
    // switch smears; only the toggle's own icons animate.
    const freeze = document.createElement('style')
    freeze.textContent =
      '*:not([data-theme-icon]),*::before,*::after{transition:none!important}'
    document.head.appendChild(freeze)

    const isDark = document.documentElement.classList.toggle('dark')
    try {
      localStorage.setItem('theme', isDark ? 'dark' : 'light')
    } catch {}

    // Apply the new colors while transitions are off, then restore them.
    void document.body.offsetHeight
    requestAnimationFrame(() => requestAnimationFrame(() => freeze.remove()))
  }

  document.addEventListener('click', (event) => {
    const target = event.target as Element | null
    if (!target?.closest('[data-theme-toggle]')) return

    const reduceMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches
    if (!document.startViewTransition || reduceMotion) return toggleTheme()

    // Opts this view transition into the diagonal reveal in global.css.
    const root = document.documentElement
    root.setAttribute('data-theme-transition', '')
    document
      .startViewTransition(toggleTheme)
      .finished.finally(() => root.removeAttribute('data-theme-transition'))
  })
</script>
