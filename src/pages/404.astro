---
import Layout from '../layouts/Layout.astro'
import Button from '../components/Button.vue'
import ViewButton from '../components/ViewButton.vue'
import TheFooter from '../components/TheFooter.vue'
---

<Layout title="Portfolio | Carlos Marques" page="none">
  <div class="rounded-4xl bg-brand-lightest dark:bg-brand-darker relative">
    <div class="flex p-8">
      <div class="flex gap-3 items-center">
        <span class="status-dot" aria-hidden="true"></span>
        <h2 class="font-medium text-xl">Oops! 404</h2>
      </div>
    </div>
    <div class="reveal flex items-center justify-center flex-col gap-3 min-h-[60vh]">
      <p class="font-semibold text-3xl tracking-tight">Page not found.</p>
      <p class="text-brand-grayDark dark:text-brand-gray text-sm">This page does not exist.</p>
      <div class="flex items-center gap-3 mt-3">
        <Button variant="primary" to="/" text="Back to Home" />
        <ViewButton text="See My Work" />
      </div>
    </div>
    <TheFooter />
  </div>
</Layout>
