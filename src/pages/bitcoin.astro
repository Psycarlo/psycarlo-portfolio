---
import { Image } from 'astro:assets'

import Layout from '../layouts/Layout.astro'
import WrapperLayout from '../layouts/WrapperLayout.astro'
import ContentLayout from '../layouts/ContentLayout.vue'
import BitcoinCard from '../components/BitcoinCard.astro'

import splash from '../assets/splash.png'
import qr from '../assets/qr.png'
import qrln from '../assets/qrln.png'
---

<Layout title="Bitcoin | Carlos Marques" page="bitcoin">
  <WrapperLayout
    topic="Bitcoin"
    title="Absolute Scarcity"
    description="Bitcoin is the hardest money in the world. It brings peace, love, hope and freedom to the human race."
  >
    <ContentLayout>
      <BitcoinCard>
        <div
          class="img-frame bg-brand-lighty dark:bg-brand-dark overflow-hidden rounded-2xl *:block"
        >
          <Image src={splash} alt="Psybitcoin Splash" class="rounded-2xl" />
        </div>
        <Image
          src={qr}
          width={480}
          alt="Bitcoin Address QR Code"
          class="img-outline rounded-2xl transition-[scale] duration-200 ease-out motion-safe:hover:scale-[1.02]"
          slot="qr"
        />
        <Image
          src={qrln}
          width={480}
          alt="Lightning Address QR Code"
          class="img-outline rounded-2xl transition-[scale] duration-200 ease-out motion-safe:hover:scale-[1.02]"
          slot="qrln"
        />
      </BitcoinCard>
    </ContentLayout>
  </WrapperLayout>
</Layout>
