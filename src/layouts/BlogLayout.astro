---
import { Image } from 'astro:assets'
import WrapperLayout from './WrapperLayout.astro'
import BackLink from '../components/BackLink.astro'

const { title, description, pubDate, updatedDate, heroImage, id } = Astro.props
---

<WrapperLayout topic="" title="" description="">
  <div class="p-8">
    <BackLink href="/blog/" text="All posts" />
    <div class="mt-2">
      <article>
        <div class="flex flex-col gap-2">
          <!-- Not revealed: it morphs from the post card via its transition name. -->
          <Image
            src={heroImage}
            alt=""
            class="img-outline w-full rounded-2xl"
            transition:name={`hero-${id}`}
          />
          <div class="reveal flex flex-col gap-2">
            <span
              class="text-brand-grayDark dark:text-brand-gray font-mono text-xs tracking-wide uppercase"
            >
              {
                new Intl.DateTimeFormat('en-US', {
                  month: 'long',
                  day: 'numeric',
                  year: 'numeric'
                }).format(pubDate)
              }
            </span>
            <h1 class="text-2xl font-semibold tracking-tight">{title}</h1>
            <p class="dark:text-gray-300">{description}</p>
          </div>
        </div>
        <div class="h-px w-full bg-brand-lighty dark:bg-brand-dark my-8"></div>
        <div class="reveal prose dark:prose-invert">
          <slot />
        </div>
      </article>
    </div>
    <div class="mt-10 h-px w-full bg-brand-lighty dark:bg-brand-dark"></div>
  </div>
</WrapperLayout>
