---
import LetsWorkTogether from '../components/LetsWorkTogether.astro'
import TheFooter from '../components/TheFooter.vue'

interface Props {
  topic: string
  title: string
  description: string
  withoutLetsWorkTogether?: boolean
}

const {
  topic,
  title,
  description,
  withoutLetsWorkTogether = false
} = Astro.props
---

<div class="bg-brand-lightest dark:bg-brand-darker relative rounded-4xl">
  {
    (topic || title || description) && (
      <div class="p-8">
        {topic && (
          <div class="reveal flex items-center gap-2">
            <span class="status-dot" aria-hidden="true" />
            <h2 class="text-xl font-medium">{topic}</h2>
          </div>
        )}
        {title && description && (
          <div class="reveal mt-10 flex flex-col gap-2">
            <h3 class="text-4xl font-semibold tracking-tight">{title}</h3>
            <p class="text-brand-grayDark dark:text-brand-grayLight">
              {description}
            </p>
          </div>
        )}
      </div>
    )
  }
  <slot />
  {!withoutLetsWorkTogether && <LetsWorkTogether />}
  <TheFooter />
</div>
