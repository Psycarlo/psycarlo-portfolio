---
import '@fontsource-variable/inter'
import interLatinFont from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url'
import TheHeader from '../components/TheHeader.astro'
import { ClientRouter } from 'astro:transitions'
import '../styles/global.css'

type CurrentPage =
  | 'home'
  | 'about'
  | 'projects'
  | 'technologies'
  | 'bitcoin'
  | 'blog'
  | 'none'

interface Props {
  title: string
  page: CurrentPage
}

const { title, page } = Astro.props

const description = 'Software Engineer & Designer from Portugal.'
const ogImage = new URL('/main.png', Astro.site).href
const ogUrl = new URL(Astro.url.pathname, Astro.site).href
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link
      rel="preload"
      href={interLatinFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:title" content="Portfolio | Carlos Marques" />
    <meta itemprop="description" content={description} />
    <meta property="og:description" content={description} />
    <meta itemprop="image" content={ogImage} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <script is:inline>
      // Runs before first paint so there is no flash of the wrong theme and
      // reveal-on-enter content starts hidden. The router replaces <html>
      // attributes on navigation, so the same state is copied onto the
      // incoming document before it is swapped in.
      ;(function () {
        const root = document.documentElement
        let theme = null
        try {
          theme = localStorage.getItem('theme')
        } catch {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light'
        }
        const motion =
          'IntersectionObserver' in window &&
          window.matchMedia('(prefers-reduced-motion: no-preference)').matches
        root.classList.toggle('dark', theme === 'dark')
        root.toggleAttribute('data-motion', motion)

        document.addEventListener('astro:before-swap', (event) => {
          const next = event.newDocument.documentElement
          next.classList.toggle('dark', root.classList.contains('dark'))
          next.toggleAttribute('data-motion', root.hasAttribute('data-motion'))
        })
      })()
    </script>
    <ClientRouter />
  </head>
  <body
    class="bg-brand-light dark:bg-brand-darkest font-brand text-brand-darkest dark:text-brand-lightest antialiased"
  >
    <main class="flex justify-center px-2 xs:px-4 sm:px-8">
      <div class="w-full max-w-140 py-4 flex flex-col gap-4 min-w-0">
        <TheHeader page={page} />
        <div class="pt-20">
          <slot />
        </div>
      </div>
    </main>
    <script>
      import '../scripts/motion'
    </script>
  </body>
</html>
